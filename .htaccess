# .htaccess for Hostinger & Laragon SFT Web Application

# 1. Clean HTML URLs & Modern Short Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent rewriting actual files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't touch API or Static Asset Folders
    RewriteCond %{REQUEST_URI} ^/(api|assets|css|js|uploads|image|styles|scratch)/ [NC]
    RewriteRule ^ - [L]

    # Direct custom clean shortcuts
    RewriteRule ^wiraniaga/?$ pages_spv/wiraniaga.html [L,NC]
    RewriteRule ^monitoring/?$ pages_kacab/monitoring_spv.html [L,NC]
    RewriteRule ^monitoring-spv/?$ pages_kacab/monitoring_spv.html [L,NC]
    RewriteRule ^spv/?$ pages_spv/index_spv.html [L,NC]
    RewriteRule ^kacab/?$ pages_kacab/index_kacab.html [L,NC]
    RewriteRule ^dashboard-spv/?$ pages_spv/index_spv.html [L,NC]
    RewriteRule ^dashboard-kacab/?$ pages_kacab/index_kacab.html [L,NC]
    RewriteRule ^database-followup/?$ pages_spv/followup_database.html [L,NC]
    RewriteRule ^crm/?$ pages_spv/followup_database.html [L,NC]
    RewriteRule ^approval/?$ pages_spv/approval.html [L,NC]
    RewriteRule ^target-spv/?$ pages_spv/target.html [L,NC]
    RewriteRule ^target-kacab/?$ pages_kacab/target_kacab.html [L,NC]

    # Check directly if file.html exists
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # Check inside pages_spv/
    RewriteCond %{DOCUMENT_ROOT}/pages_spv/$1.html -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/sft/pages_spv/$1.html -f
    RewriteRule ^([^/]+)/?$ pages_spv/$1.html [L]

    # Check inside pages_kacab/
    RewriteCond %{DOCUMENT_ROOT}/pages_kacab/$1.html -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/sft/pages_kacab/$1.html -f
    RewriteRule ^([^/]+)/?$ pages_kacab/$1.html [L]

    # Check inside pages/
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/sft/pages/$1.html -f
    RewriteRule ^([^/]+)/?$ pages/$1.html [L]
</IfModule>

# 2. Add Proper MIME Types for PWA
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType application/x-web-app-manifest+json .webapp
    AddType text/cache-manifest .appcache
</IfModule>

# 3. Enable Gzip / Deflate Compression for Speed
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/manifest+json
</IfModule>

# 4. Enterprise Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

# 5. Prevent Direct Listing of Directories
Options -Indexes

# 6. Block Direct Access to Sensitive System Files (.sql, .log, .env, .git, koneksi.php)
<FilesMatch "\.(sql|log|env|git|htaccess|ini|sh|bak)$">
    Require all denied
</FilesMatch>

<Files "koneksi.php">
    # Prevent direct browser access to DB credentials file while allowing PHP include
    Order Deny,Allow
    Deny from all
</Files>
